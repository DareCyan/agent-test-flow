# 运行期产物
data/runs/
data/install_runs/
data/agents.json
uploads/
build/

# 本地 LLM 配置（含 api_key，不要提交）
backend/config.json
backend/config.yaml
backend/config.yml

# examples/agent/ 只提交模板文件：
# 填好的示例配置（可能带真实 key）、示例安装说明（含机器地址/私钥路径）与示例安装包都只留在本地，不进仓库
examples/agent/*
!examples/agent/agent-config.template.yaml
!examples/agent/agent-config.template.json
!examples/agent/install.template.json
# 示例包源码、构建/校验脚本：体积小且无凭据，允许提交
!examples/agent/_pkg/
!examples/agent/_pkg/**
!examples/agent/build_files.py
!examples/agent/validate_files.py

# Python
__pycache__/
*.pyc

# opencode 离线安装包：大体积下载产物与构建中间目录不进仓库
tools/opencode-bundle/cache/
tools/opencode-bundle/stage/
tools/opencode-bundle/dist/
tools/opencode-bundle/.askpass.cmd
tools/opencode-bundle/askpass.cmd
# 凭据与环境相关的本机文件：绝不进仓库
tools/opencode-bundle/askpass.secret
tools/opencode-bundle/ssh_config.local
tools/opencode-bundle/.oc-*
